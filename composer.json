{
  "name": "billythekid/punk-api",
  "description": "PHP Wrapper for the Punk API - BrewDog DIY Dog beer recipes",
  "require": {
    "php": ">=8.3",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "billythekid"
    }
  ],
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "billythekid\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "docs": "phpdoc -d src -t docs --force"
  }
}
